<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PreviewHost</RootNamespace>
    <AssemblyName>PreviewHost</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <!-- 主项目 csproj 固定了 SelfContained，被 ProjectReference 引用时要求本工程同样自包含同 RID -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LanFileShare\LanFileShare.csproj" />
  </ItemGroup>

</Project>
