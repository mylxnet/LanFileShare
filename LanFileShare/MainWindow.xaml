<Window x:Class="LanFileShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="局域网文件快传"
        Width="420" Height="560"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Icon="/Resources/appicon.png">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 标题 -->
            <RowDefinition Height="*"/>     <!-- 二维码区 -->
            <RowDefinition Height="Auto"/>  <!-- 提示 -->
            <RowDefinition Height="Auto"/>  <!-- 路径选择 -->
            <RowDefinition Height="Auto"/>  <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="📲 局域网文件快传"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <!-- 二维码区 -->
        <Border Grid.Row="1"
                Background="{StaticResource BgSubtle}"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <Border Background="White"
                        CornerRadius="8"
                        Padding="8"
                        HorizontalAlignment="Center"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1">
                    <Image x:Name="QrImage"
                           Width="240" Height="240"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"/>
                </Border>
                <TextBlock x:Name="UrlText"
                           Text=""
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           Margin="0,12,0,0"
                           FontFamily="Consolas, JetBrains Mono, monospace"/>
            </StackPanel>
        </Border>

        <!-- 操作提示 -->
        <TextBlock Grid.Row="2"
                   Text="用手机微信或浏览器扫码，即可上传图片或文档"
                   HorizontalAlignment="Center"
                   FontSize="13"
                   Foreground="{StaticResource TextMuted}"
                   Margin="0,0,0,16"/>

        <!-- 路径选择区 -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Background="{StaticResource BgSubtle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="📁 保存到"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource TextMuted}"/>
                <TextBlock x:Name="PathText"
                           Grid.Column="1"
                           Text="（未选择保存路径）"
                           VerticalAlignment="Center"
                           Margin="10,0,10,0"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Foreground="{StaticResource TextPrimary}"/>
                <Button Grid.Column="2"
                        Content="更改…"
                        Style="{StaticResource GhostButton}"
                        Click="OnChangePathClick"/>
            </Grid>
        </Border>

        <!-- 状态栏（备用，v1 默认隐藏） -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Text=""
                   Margin="0,8,0,0"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource TextMuted}"/>
    </Grid>
</Window>
